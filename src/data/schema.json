{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI 教育周刊数据契约",
  "description": "按文件使用 manifest、catalog、issue 或 profileCatalog 定义。界面沿用六页周刊与独立累计创意库；人物背景在 data/people.json 独立维护，不改写本期动态事实和日期。",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/issue"
    },
    {
      "$ref": "#/$defs/profileCatalog"
    },
    {
      "$ref": "#/$defs/editorialCatalog"
    }
  ],
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "latestIssueId",
        "libraryAsOf",
        "issues"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "latestIssueId": {
          "type": "string"
        },
        "libraryAsOf": {
          "type": "string",
          "format": "date"
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "number",
              "date",
              "title",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "title": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "pattern": "^issues/[^/]+\\.json$"
              }
            }
          }
        }
      }
    },
    "idea": {
      "type": "object",
      "required": [
        "difficultyGroup",
        "difficulty",
        "uses",
        "updatedAt",
        "title",
        "firstIssue",
        "sources",
        "firstSeen",
        "id",
        "stageBasis",
        "originalDate",
        "tools",
        "lastVerified",
        "categories",
        "educationLevels",
        "scopeTags",
        "audienceTypes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "firstIssue": {
          "type": "string"
        },
        "originalDate": {
          "type": "string"
        },
        "difficulty": {
          "type": "string"
        },
        "stageBasis": {
          "type": "string"
        },
        "firstSeen": {
          "type": "string",
          "format": "date"
        },
        "updatedAt": {
          "type": "string",
          "format": "date"
        },
        "lastVerified": {
          "type": "string",
          "format": "date"
        },
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "图像设计",
              "故事视频",
              "音乐声音",
              "互动游戏",
              "Agent自动化",
              "个性化体验",
              "教学应用"
            ]
          }
        },
        "educationLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "学前教育",
              "小学教育",
              "初中教育",
              "高中阶段教育",
              "高等教育"
            ]
          }
        },
        "audienceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "职业教育",
              "成人与继续教育",
              "教育工作者"
            ]
          }
        },
        "scopeTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "跨学段",
              "未限定"
            ]
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficultyGroup": {
          "enum": [
            "入门",
            "进阶",
            "分层"
          ]
        },
        "ageRestriction": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "asOf",
        "items",
        "categoryOrder",
        "educationLevelOrder",
        "audienceTypeOrder",
        "scopeTagOrder"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "asOf": {
          "type": "string",
          "format": "date"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/idea"
          }
        },
        "categoryOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "图像设计",
              "故事视频",
              "音乐声音",
              "互动游戏",
              "Agent自动化",
              "个性化体验",
              "教学应用"
            ]
          }
        },
        "educationLevelOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "学前教育",
              "小学教育",
              "初中教育",
              "高中阶段教育",
              "高等教育"
            ]
          }
        },
        "audienceTypeOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "职业教育",
              "成人与继续教育",
              "教育工作者"
            ]
          }
        },
        "scopeTagOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "跨学段",
              "未限定"
            ]
          }
        }
      },
      "description": "所有期刊共用的累计创意库；稳定 ID 去重，保留首次收录信息。选择期刊或筛选不得删除累计条目。"
    },
    "issue": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "number",
        "date",
        "title",
        "window",
        "cutoff",
        "education",
        "publicFigures",
        "newIdeaIds",
        "revisionNote"
      ],
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "window": {
          "type": "object",
          "required": [
            "start",
            "end"
          ]
        },
        "education": {
          "type": "object",
          "required": [
            "items",
            "summaries"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/educationItem"
              },
              "description": "完整教育文章，是本期关注分布表的唯一计数来源。"
            },
            "summaries": {
              "type": "array",
              "description": "本期预览摘要，不作为分布表重复计数。"
            },
            "watchlist": {
              "type": "array",
              "deprecated": true,
              "description": "既有研究溯源记录，可保留；不渲染到周刊，新期非必填。"
            }
          }
        },
        "publicFigures": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "required": [
              "name",
              "title",
              "summary",
              "date",
              "verification"
            ]
          }
        },
        "newIdeaIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "该期首次收录的累计库稳定 ID，用于库内本期新增筛选，不渲染为周刊创意索引。"
        },
        "creativeSnapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "summary",
              "originalDate"
            ]
          },
          "description": "可选的历史创意摘要溯源字段。保留既有原文，不在周刊渲染；新期无需生成。",
          "deprecated": true
        },
        "revisionNote": {
          "type": "string"
        },
        "creativeWatchlist": {
          "type": "array",
          "deprecated": true,
          "description": "可选的历史创意追踪记录，仅保留溯源，不在周刊渲染。"
        }
      },
      "description": "每期教育与人物正文的独立快照；追加真实新期，纠错保留日期和原因。"
    },
    "educationItem": {
      "type": "object",
      "description": "单篇教育条目；原始内容、事实和证据字段完整保留。id 须在该期唯一，校验器负责检查。",
      "required": [
        "id",
        "category",
        "educationLevels",
        "audienceTypes",
        "scopeTags",
        "date",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "原始主题名称，直接作为关注分布表行；不得为布局调整重分类。"
        },
        "educationLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "学前教育",
              "小学教育",
              "初中教育",
              "高中阶段教育",
              "高等教育"
            ]
          },
          "description": "学段标签；多于一项时文章在分布表只计入跨学段一次。"
        },
        "audienceTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "对象标签独立统计，可含教育工作者、职业教育、成人与继续教育、家长、青少年等，不作为矩阵学段列。"
        },
        "scopeTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "跨学段",
              "未限定"
            ]
          },
          "description": "跨学段优先于具体学段归桶；未限定仅在无具体学段且未标跨学段时作为兜底桶。"
        },
        "date": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "profileCatalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "asOf",
        "items",
        "publicationStatus"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "asOf": {
          "type": "string",
          "format": "date"
        },
        "publicationStatus": {
          "const": "public-edition"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/personProfile"
          }
        }
      }
    },
    "personProfile": {
      "type": "object",
      "required": [
        "id",
        "name",
        "identity",
        "bio",
        "contributions",
        "followReason",
        "profileUpdatedAt",
        "profileSources",
        "portrait"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^person-"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "bio": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "text",
              "source"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object",
                "required": [
                  "title",
                  "url"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  }
                }
              }
            }
          }
        },
        "followReason": {
          "type": "string",
          "minLength": 1
        },
        "profileUpdatedAt": {
          "type": "string",
          "format": "date"
        },
        "profileSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        },
        "portrait": {
          "type": "object",
          "required": [
            "path",
            "sourcePage",
            "imageUrl",
            "credit",
            "alt",
            "rightsStatus"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourcePage": {
              "type": [
                "string",
                "null"
              ]
            },
            "imageUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "credit": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "rightsStatus": {
              "type": "string",
              "minLength": 1
            },
            "missingReason": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "path": {
                    "type": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "path": {
                    "pattern": "^assets/portraits/[^/]+$"
                  },
                  "sourcePage": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "imageUrl": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "credit": {
                    "minLength": 1
                  },
                  "alt": {
                    "minLength": 1
                  }
                }
              },
              "else": {
                "required": [
                  "missingReason"
                ],
                "properties": {
                  "missingReason": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "editorialCatalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "issues"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "issues": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/issueEditorial"
          }
        }
      }
    },
    "issueEditorial": {
      "type": "object",
      "required": [
        "experiments",
        "changes",
        "revisionLog",
        "factCorrections"
      ],
      "properties": {
        "experiments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "audience",
              "estimatedMinutes",
              "steps",
              "verificationGoal",
              "sourceIds",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "audience": {
                "type": "string",
                "minLength": 1
              },
              "estimatedMinutes": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "string",
                "minLength": 1
              },
              "verificationGoal": {
                "type": "string",
                "minLength": 1
              },
              "sourceIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "const": "编辑建议，未实测"
              }
            }
          }
        },
        "changes": {
          "type": "object",
          "required": [
            "status",
            "baselineIssue",
            "baselineDate",
            "items",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "baseline",
                "compared",
                "no-verified-change"
              ]
            },
            "baselineIssue": {
              "type": "string",
              "minLength": 1
            },
            "baselineDate": {
              "type": "string",
              "format": "date"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "previous",
                  "current",
                  "changeType",
                  "sourceDate",
                  "sources",
                  "firstIssue",
                  "firstItemId",
                  "previousIssue",
                  "previousItemId"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "previous": {
                    "type": "string",
                    "minLength": 1
                  },
                  "current": {
                    "type": "string",
                    "minLength": 1
                  },
                  "changeType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "firstIssue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "firstItemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "previousIssue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "previousItemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "title",
                        "url"
                      ],
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https://"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "baseline",
                      "no-verified-change"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "items": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "items": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "revisionLog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "version",
              "type",
              "summary"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "factCorrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "itemId",
              "date",
              "before",
              "after",
              "reason",
              "sources"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  }
                }
              }
            }
          }
        },
        "evidenceUpdates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "itemId",
              "kind",
              "before",
              "after",
              "reason",
              "sources"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "itemId": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "before": {
                "type": "object"
              },
              "after": {
                "type": "object"
              },
              "reason": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "url"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
